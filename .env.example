# Telegram BotFather token (majburiy)
BOT_TOKEN=123456:ABCDEF...

# Vercel URL (deploydan keyin) — oxirida / bo'lmasin
WEBAPP_URL=https://your-app.vercel.app

# Bot setup himoyasi: /api/bot/setup?secret=...
SETUP_SECRET=change-me-long-random

# Local brauzerda test uchun (productionda o'chiring)
ALLOW_DEMO_USER=1
