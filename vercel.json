{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=@caseverse/web",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 30,
      "includeFiles": "{packages/shared/**,apps/api/**}"
    }
  }
}
